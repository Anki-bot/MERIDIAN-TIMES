const unsafeMutationArbitrary: fc.Arbitrary<UnsafeMutation> = fc.oneof(
  fc.record({
    kind: fc.constant("path" as const),
    path: fc.constantFrom(
      "/tmp/outside-successor.json",
      "C:/temp/outside-successor.json",
