      .toBeLessThan(observedSteps.indexOf("prepared-transaction"));
    expect(observedSteps.indexOf("installed-package-manifest"))
      .toBeLessThan(observedSteps.indexOf("committed-release-pointer"));
    expect(await readFile(resolve(
