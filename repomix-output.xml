    const invalidRecords: readonly ReconstructionRecord[] = [
      {
        boundaryMask: center,
        fill: opaqueFill,
        footprintMask,
        id: "missing-footprint",
        reconstructionMask: empty,
        zOrder: 1,
      },
      {
