};
type BuilderModule = {
  readonly WATCH_LAYER_BUILD_INPUT_SNAPSHOT_PATH: string;
  readonly WATCH_LAYER_BUILD_METADATA_PATH: string;
  buildWatchLayerAssets(options: {
