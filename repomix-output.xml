});

describe("mask algebra, bounds, edge bands, and swept boundaries", () => {
  it("uses half-open tight bounds and deterministic alpha-preserving set operations", () => {
    const left = maskFixture(5, 4, [
      [1, 1, 64],
      [2, 1, 128],
      [1, 2, 255],
    ]);
    const right = maskFixture(5, 4, [
      [2, 1, 200],
