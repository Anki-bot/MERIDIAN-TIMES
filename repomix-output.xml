describe("alpha-preserving extraction and ordered compositing", () => {
  it("extracts the exact half-open source rectangle without mutating source or mask bytes", () => {
    const source = rgbaFixture(4, 3, (x, y) => [
      x * 40 + y,
      y * 50 + x,
