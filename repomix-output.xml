    const tourbillon = dictionaryTerms.find(({ id }) => id === "tourbillon") ?? null;
    render(
      <DefinitionPanel
        term={tourbillon}
        allTerms={dictionaryTerms}
        opener={null}
        onClose={vi.fn()}
        onSelectRelated={vi.fn()}
