      </mesh>
      <mesh material={steel} position={[0, 0, 0.04]}>
        <torusGeometry args={[0.86, 0.022, 8, 80]} />
      </mesh>
      {Array.from({ length: 10 }, (_, index) => {
        const angle = (index / 10) * Math.PI * 2;
        return (
          <group key={angle} rotation={[0, 0, angle]}>
