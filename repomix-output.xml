  isGraphNodeEnabled,
  type GraphEdge,
  type GraphNodeDefinition,
} from "@/lib/graph";
import type { DictionaryTerm, WatchAudience } from "@/lib/types";
import { useRouter } from "next/navigation"; // FIXED: Correct App Router import

// 1. Categorize the 37 brand IDs
const MEN_ONLY_BRANDS = [
  "diesel",
